@page
@model eCommerce.Web.Pages.Payment.VnPayReturnModel
@{
    ViewData["Title"] = "Kết quả thanh toán";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header @(Model.PaymentSuccess ? "bg-success" : "bg-danger") text-white">
                    <h3 class="mb-0">
                        <i class="fas @(Model.PaymentSuccess ? "fa-check-circle" : "fa-times-circle")"></i>
                        @(Model.PaymentSuccess ? "Thanh toán thành công" : "Thanh toán thất bại")
                    </h3>
                </div>
                <div class="card-body">
                    @if (Model.PaymentSuccess)
                    {
                        <div class="alert alert-success">
                            <h4>@Model.PaymentMessage</h4>
                        </div>
                        
                        <table class="table table-bordered">
                            <tr>
                                <th>Mã đơn hàng:</th>
                                <td>@Model.OrderId</td>
                            </tr>
                            <tr>
                                <th>Mã giao dịch:</th>
                                <td>@Model.TransactionId</td>
                            </tr>
                            <tr>
                                <th>Phương thức thanh toán:</th>
                                <td>@Model.PaymentMethod</td>
                            </tr>
                            <tr>
                                <th>Mô tả:</th>
                                <td>@Model.OrderDescription</td>
                            </tr>
                        </table>

                        <div class="text-center mt-4">
                            <a href="/Orders" class="btn btn-primary">
                                <i class="fas fa-list"></i> Xem đơn hàng
                            </a>
                            <a href="/" class="btn btn-secondary">
                                <i class="fas fa-home"></i> Về trang chủ
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <h4>@Model.PaymentMessage</h4>
                            <p class="mb-0">Vui lòng thử lại hoặc liên hệ hỗ trợ nếu vấn đề vẫn tiếp diễn.</p>
                        </div>

                        <div class="text-center mt-4">
                            <a href="/Cart" class="btn btn-warning">
                                <i class="fas fa-shopping-cart"></i> Quay lại giỏ hàng
                            </a>
                            <a href="/" class="btn btn-secondary">
                                <i class="fas fa-home"></i> Về trang chủ
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>