@page
@model eCommerce.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-page="/Admin/AddProduct" class="btn btn-primary">Thêm Sản Phẩm Mới</a>
</div>

@if (TempData["success"] != null)
{
    <div class="alert alert-success">@TempData["success"]</div>
}

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Ảnh</th>
            <th>Tên Sản Phẩm</th>
            <th>Danh Mục</th>
            <th>Thương Hiệu</th>
            <th>Giá</th>
            <th>Tồn Kho</th>
            <th style="width: 120px;">Hành Động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>
                    <img src="@product.ImageUrl" alt="@product.Name" style="width: 60px; height: 60px; object-fit: cover;" />
                </td>
                <td>@product.Name</td>
                <td>@product.Category?.Name</td>
                <td>@product.Brand?.Name</td>
                <td>@product.Price.ToString("N0") đ</td>
                <td>@product.StockQuantity</td>
                <td>
                    <a asp-page="./EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-page="./DeleteProduct" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>