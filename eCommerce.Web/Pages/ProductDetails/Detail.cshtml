@page "/Product/{id:int}" 
@model eCommerce.Web.Pages.ProductDetails.DetailModel 
@{
    ViewData["Title"] = Model.Product?.Name ?? "Chi tiết Sản phẩm"; // Lấy tên sản phẩm làm tiêu đề
}

@if (Model.Product != null)
{
    <div class="product-detail-layout">
        <div class="product-detail-image">
             @{
                var imageUrl = Model.Product?.ImageUrl ?? string.Empty;
                var normalizedUrl = Url.Content("~/" + imageUrl.TrimStart('~', '/'));
            }
            <img src="@normalizedUrl"
                 alt="@Model.Product.Name"
                 asp-append-version="true"
                 onerror="this.onerror=null;this.src='https://placehold.co/600x400/E2E8F0/4A5568?text=Image+Not+Found';" />
        </div>
        <div class="product-detail-info">
            <h1>@Model.Product.Name</h1>
            <p class="product-detail-price">@Model.Product.Price.ToString("N0") ₫</p>
            <p class="product-detail-description">@Model.Product.Description</p>
            
            @if (Model.Product.StockQuantity > 0)
            {
                <div class="product-stock-detail @(Model.Product.StockQuantity <= Model.Product.MinStockLevel ? "low-stock" : "in-stock")">
                    @if (Model.Product.StockQuantity <= Model.Product.MinStockLevel)
                    {
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>Sắp hết hàng - Chỉ còn @Model.Product.StockQuantity sản phẩm</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle"></i>
                        <span>Còn @Model.Product.StockQuantity sản phẩm</span>
                    }
                </div>
            }
            else
            {
                <div class="product-stock-detail out-of-stock">
                    <i class="bi bi-x-circle"></i>
                    <span>Sản phẩm tạm hết hàng</span>
                </div>
            }
            
             <div class="product-actions">
                <form method="post" asp-page="/Cart" asp-route-handler="Add" class="inline-form">
                    <input type="hidden" name="productId" value="@Model.Product.Id" />
                    <input type="hidden" name="qty" value="1" />
                    <button type="submit" class="btn btn-primary btn-lg" @(Model.Product.StockQuantity <= 0 ? "disabled" : "")>
                        <i class="bi bi-cart-plus" style="margin-right: 12px;" aria-hidden="true"></i>Thêm vào giỏ hàng
                    </button>
                </form>
            </div>
             <hr />
            <h4>Thông số kỹ thuật</h4>
            <ul class="product-specifications">
                @foreach (var spec in Model.Product.Specifications)
                {
                    <li><strong>@spec.Key:</strong> @spec.Value</li>
                }
             </ul>

            <div class="product-reviews mt-4">
                <h4>Đánh giá</h4>
                <div class="mb-2">
                    <strong>Điểm trung bình:</strong> @Model.AverageRating.ToString("0.0") / 5
                    <span class="ms-3">(@Model.ReviewCount đánh giá)</span>
                </div>

                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    <div class="reviews-list">
                        @foreach (var r in Model.Reviews)
                        {
                            <div class="review-item mb-3">
                                <div><strong>@(r.UserName ?? "Khách")</strong> <small class="text-muted">@r.CreatedDate.ToLocalTime().ToString("g")</small></div>
                                    <div>
                                        <span class="review-rating">@for (int s = 0; s < r.Rating; s++) { <span>⭐</span> }</span>
                                        @if (!string.Equals(r.Status, "Approved", System.StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning text-dark ms-2">@r.Status</span>
                                        }
                                    </div>
                                <div class="review-comment">@r.Comment</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>Chưa có đánh giá nào.</p>
                }
            </div>
        </div>
    </div>
}
else
{
    <h1>Sản phẩm không tồn tại</h1>
    <p>Không tìm thấy sản phẩm bạn yêu cầu.</p>
}

@section Scripts {
    }
