@page "/Product/{id:int}" 
@model eCommerce.Web.Pages.ProductDetails.DetailModel 
@{
    ViewData["Title"] = Model.Product?.Name ?? "Chi tiết Sản phẩm"; // Lấy tên sản phẩm làm tiêu đề
}

@if (Model.Product != null)
{
    <div class="product-detail-layout">
        <div class="product-detail-image">
             @{
                var imageUrl = Model.Product?.ImageUrl ?? string.Empty;
                var normalizedUrl = Url.Content("~/" + imageUrl.TrimStart('~', '/'));
            }
            <img src="@normalizedUrl"
                 alt="@Model.Product.Name"
                 asp-append-version="true"
                 onerror="this.onerror=null;this.src='https://placehold.co/600x400/E2E8F0/4A5568?text=Image+Not+Found';" />
        </div>
        <div class="product-detail-info">
            <h1>@Model.Product.Name</h1>
            <p class="product-detail-price">@Model.Product.Price.ToString("N0") ₫</p>
            <p class="product-detail-description">@Model.Product.Description</p>
             <div class="product-actions">
                <form method="post" asp-page="/Cart" asp-route-handler="Add" class="inline-form">
                    <input type="hidden" name="productId" value="@Model.Product.Id" />
                    <input type="hidden" name="qty" value="1" />
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-cart-plus" style="margin-right: 12px;" aria-hidden="true"></i>Thêm vào giỏ hàng
                    </button>
                </form>
            </div>
             <hr />
            <h4>Thông số kỹ thuật</h4>
            <ul class="product-specifications">
                @foreach (var spec in Model.Product.Specifications)
                {
                    <li><strong>@spec.Key:</strong> @spec.Value</li>
                }
             </ul>
        </div>
    </div>
}
else
{
    <h1>Sản phẩm không tồn tại</h1>
    <p>Không tìm thấy sản phẩm bạn yêu cầu.</p>
}

@section Scripts {
    }
