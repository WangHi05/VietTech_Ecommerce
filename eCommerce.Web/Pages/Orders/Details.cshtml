@page "{id:int}"
@model eCommerce.Web.Pages.Orders.DetailsModel
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h2>Chi tiết đơn hàng</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (Model.Order == null)
{
    <p>Không tìm thấy đơn hàng.</p>
}
else
{
    <div class="card order-card mb-3">
        <div class="card-body">
            <h5>Đơn hàng #@Model.Order.Id</h5>
            <p>Ngày: @Model.Order.CreatedAt.ToLocalTime().ToString("g")</p>
            <p>Trạng thái: 
                @{ 
                    // Cập nhật logic switch để nhất quán với trang Index
                    var statusText = Model.Order.Status switch
                    {
                        "Đang chờ" => "Đang chờ",
                        "Đang xử lý" => "Đang xử lý",
                        "Đang giao hàng" => "Đang giao hàng",
                        "Hoàn tất" => "Hoàn tất",
                        "Đã hủy" => "Đã hủy",
                        "Không được xác nhận" => "Không được xác nhận",
                        var s => s ?? ""
                    };
                }
                <strong>@statusText</strong>
            </p>
            <p>Địa chỉ: @Model.Order.ShippingName - @Model.Order.ShippingAddress</p>
            <p>Tổng: @String.Format("{0:N0}", Model.Order.Total)</p>

            <h6>Items</h6>
            <ul class="order-items mb-3">
                
                @foreach (var it in Model.Order.Items)
                {
                    <li class="order-item">
                        <div class="order-left">
                            <strong class="order-item-name">@it.Name</strong> 
                            <div class="order-item-qty">SL: @it.Quantity</div>
                            <div class="order-meta-desktop mt-2">
                                <div class="order-price">@String.Format("{0:N0}", it.Price)</div> 
                                @if (Model.Order.Status == "Hoàn tất")
                                {
                                    @if (Model.ReviewedProductIds != null && Model.ReviewedProductIds.Contains(it.ProductId))
                                    {
                                        <span class="badge badge-success badge-inline">Đã đánh giá</span> 
                                    }
                                    else
                                    {
                                        <a class="btn btn-compact ms-2" asp-page="/Reviews/Create" asp-route-productId="@it.ProductId" asp-route-orderId="@Model.Order.Id">Đánh giá</a> 
                                    }
                                }
                                </div>
                        </div>
                        <div class="order-right" aria-hidden="true"></div>
                    </li>
                }
            </ul>

            <form method="post">
                <button type="submit" class="btn btn-success">Mua lại</button>
                <a class="btn btn-secondary" asp-page="/Orders/Index">Quay lại</a>
            </form>
        </div>
    </div>
}