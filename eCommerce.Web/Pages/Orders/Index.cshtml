@page
@model eCommerce.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<h2>Đơn hàng của tôi</h2>

@if (Model.Orders == null || Model.Orders.Count == 0)
{
    <p>Bạn chưa có đơn hàng nào.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th class="text-start">Mã đơn</th>
                <th class="text-start">Ngày</th>
                <th class="text-end">Tổng tiền</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-center">Đã đánh giá</th>
                <th class="text-end" style="width:150px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model.Orders)
            {
                <tr>
                    <td class="text-start">@o.Id</td>
                    <td class="text-start">@o.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-end">@String.Format("{0:N0}", o.Total)</td>
                    <td class="text-center">
                        @{ 
                            var statusText = o.Status switch
                            {
                                "Pending" => "Chờ xác nhận",
                                "Đang Giao" => "Đang giao",
                                "Không được xác nhận" => "Không được xác nhận",
                                "Completed" => "Hoàn tất",
                                var s => s ?? ""
                            };
                        }
                        <span>@statusText</span>
                    </td>
                    <td class="text-center">
                        @if (Model.ReviewedOrderIds != null && Model.ReviewedOrderIds.Contains(o.Id))
                        {
                            <span class="badge bg-success">Đã đánh giá</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Chưa đánh giá</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Orders/Details" asp-route-id="@o.Id">Xem</a>
                        <form method="post" asp-page="/Orders/Details" asp-route-id="@o.Id" style="display:inline">
                            <button type="submit" name="reorder" value="1" class="btn btn-sm btn-success">Mua lại</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
