@page
@model eCommerce.Web.Pages.SearchModel
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
}

<div class="search-header">
    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <h1>Kết quả tìm kiếm cho: "@Model.Query"</h1>
    }
    else
    {
        <h1>Tìm kiếm sản phẩm</h1>
    }
</div>

@if (Model.SearchResults != null && Model.SearchResults.Any())
{
    @* --- PHẦN 1: KẾT QUẢ TÌM KIẾM CHÍNH (Highlight = true) --- *@
    <div class="section-search-results mb-5">
        <h3 class="border-bottom pb-2 mb-3"><i class="bi bi-search"></i> Sản phẩm cần tìm</h3>
        <div class="product-grid">
            @foreach (var product in Model.SearchResults)
            {
                <partial name="_ProductCard" model="product" view-data='new ViewDataDictionary(ViewData) { { "IsHighlight", true } }' />
            }
        </div>
    </div>

    @* --- PHẦN 2: SẢN PHẨM LIÊN QUAN (Highlight = false) --- *@
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
    {
        <div class="section-related-products mt-5 p-4 bg-light rounded">
            <h3 class="border-bottom pb-2 mb-3 text-muted">
                <i class="bi bi-stars"></i> Có thể bạn cũng thích
            </h3>
            <div class="product-grid">
                @foreach (var product in Model.RelatedProducts)
                {
                    @* Không truyền IsHighlight, mặc định sẽ là false *@
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    }
}
else
{
    <p class="text-center mt-4">Không tìm thấy sản phẩm nào phù hợp.</p>
}