@page
@model eCommerce.Web.Pages.CartModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h1>Giỏ Hàng Của Bạn</h1>

@* Success message removed to avoid persistent green banner on AJAX actions. Keep error alerts. *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Items == null || !Model.Items.Any())
{
    <p>Giỏ hàng trống.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Tổng</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr data-product-id="@item.ProductId">
                <td>
                    <img src="@item.ImageUrl" alt="" style="width:60px;height:60px;object-fit:cover;margin-right:8px;" />
                    @item.Name
                </td>
                <td>@item.Price.ToString("C")</td>
                <td>
                    <form method="post" asp-page-handler="Update" class="update-form">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <input type="number" name="quantity" value="@item.Quantity" min="0" style="width:70px;" />
                        <button class="btn btn-sm btn-primary" type="submit">Cập nhật</button>
                    </form>
                </td>
                <td class="line-total" data-product-id="@item.ProductId">@item.LineTotal.ToString("C")</td>
                <td>
                    <form method="post" asp-page-handler="Remove">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button class="btn btn-sm btn-danger" type="submit">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <div class="cart-actions">
        <h3>Áp dụng mã giảm giá</h3>
        <div class="cart-controls">
            <div class="controls-left">
                <div class="voucher-box">
                <label>Voucher đã lưu</label>
                <form method="post" asp-page-handler="ApplyVoucher" class="voucher-form">
                    <select name="UserVoucherId">
                        <option value="">-- Chọn voucher --</option>
                        @foreach (var uv in Model.UserVouchers)
                        {
                            <option value="@uv.Id">
                                @uv.Voucher.Code - 
                                @if (uv.Voucher.DiscountPercent.HasValue)
                                {
                                    <text>Giảm @(uv.Voucher.DiscountPercent?.ToString("N0") ?? "0")%</text>
                                }
                                else if (uv.Voucher.DiscountAmount.HasValue)
                                {
                                    <text>Giảm @uv.Voucher.DiscountAmount.Value.ToString("N0")₫</text>
                                }
                                (HSD: @uv.Voucher.ExpiryDate.ToString("dd/MM/yyyy"))
                            </option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">Áp dụng</button>
                </form>
                @if (!Model.UserVouchers.Any())
                {
                    <p class="text-muted small mt-2">Bạn chưa lưu voucher nào. <a asp-page="/Vouchers/Index">Xem voucher</a></p>
                }
                </div>

            </div>

            <div class="controls-right">
                <div class="cart-summary" data-test="cart-summary">
                <div class="summary-row" data-test="subtotal"><span>Tạm tính:</span><span class="value">@Model.SubTotal.ToString("N0") ₫</span></div>
                <div class="summary-row" data-test="discount"><span>Giảm giá:</span><span class="value">- @Model.Discount.ToString("N0") ₫</span></div>
                <div class="summary-row total" data-test="total"><span>Tổng cộng:</span><span class="value">@Model.Total.ToString("N0") ₫</span></div>
                </div>
                <div class="checkout-actions" style="margin-top:12px;">
                    <a class="btn btn-success btn-lg" asp-page="/Checkout">Thanh toán</a>
                    <a class="btn btn-secondary" asp-page="/Index" style="margin-left:8px;">Tiếp tục mua sắm</a>
                </div>
            </div>
        </div>
    </div>
}