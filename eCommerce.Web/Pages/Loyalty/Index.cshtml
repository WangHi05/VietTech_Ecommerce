@page
@model eCommerce.Web.Pages.Loyalty.IndexModel
@{
    ViewData["Title"] = "Điểm thưởng của bạn";
}

<div class="container my-5">
    <h1 class="mb-4"><i class="bi bi-gift"></i> Điểm thưởng của bạn</h1>

    @if (Model.LoyaltyInfo != null)
    {
        <!-- Card tổng quan -->
        <div class="row mb-4">
            <!-- Điểm hiện tại -->
            <div class="col-md-6 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-coin"></i> Điểm hiện có
                        </h5>
                        <h2 class="display-4 fw-bold mb-2 text-primary">@Model.LoyaltyInfo.TotalPoints</h2>
                        <p class="mb-0 text-muted">
                            <small>Tương đương <strong>@((Model.LoyaltyInfo.TotalPoints / 50 * 1000).ToString("N0"))đ</strong> giảm giá</small>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Hạng thành viên -->
            <div class="col-md-6 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body" style="padding-left: 2rem;">
                        <h5 class="card-title">
                            <i class="bi bi-award"></i> Hạng thành viên
                        </h5>
                        <h2 class="display-5 fw-bold mb-3">
                            <span style="color: @Model.TierColor">@Model.TierIcon @Model.LoyaltyInfo.MembershipTier</span>
                        </h2>
                        
                        @if (Model.LoyaltyInfo.MembershipTier != "Diamond")
                        {
                            <p class="mb-2">Tiến độ đến hạng <strong>@Model.NextTier</strong>:</p>
                            <div class="progress mb-2" style="height: 25px;">
                                <div class="progress-bar bg-warning" role="progressbar" 
                                     style="width: @Model.ProgressPercent%;" 
                                     aria-valuenow="@Model.ProgressPercent" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100">
                                    @Model.ProgressPercent.ToString("F0")%
                                </div>
                            </div>
                            <small class="text-muted">Còn <strong>@Model.PointsNeeded điểm</strong> nữa</small>
                        }
                        else
                        {
                            <p class="text-success"><i class="bi bi-trophy-fill"></i> Bạn đã đạt hạng cao nhất!</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Thông tin hạng -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Hệ thống hạng thành viên</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <div class="text-center p-3 border rounded">
                            <h4>🥉 Đồng</h4>
                            <p class="text-muted mb-0">0 - 999 điểm</p>
                            <small>Tích điểm cơ bản</small>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="text-center p-3 border rounded">
                            <h4>🥈 Bạc</h4>
                            <p class="text-muted mb-0">1,000 - 4,999 điểm</p>
                            <small>Freeship từ 300k</small>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="text-center p-3 border rounded">
                            <h4>🥇 Vàng</h4>
                            <p class="text-muted mb-0">5,000 - 9,999 điểm</p>
                            <small>Freeship toàn quốc</small>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="text-center p-3 border rounded">
                            <h4>💎 Kim Cương</h4>
                            <p class="text-muted mb-0">10,000+ điểm</p>
                            <small>Ưu tiên hỗ trợ</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cách tích điểm -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Cách tích điểm</h5>
            </div>
            <div class="card-body">
                <ul class="mb-0">
                    <li><strong>Mua hàng:</strong> 1,000đ = 1 điểm</li>
                    <li><strong>Quy đổi:</strong> 50 điểm = 1,000đ giảm giá</li>
                    <li><strong>Áp dụng:</strong> Đơn hàng từ 500,000đ trở lên</li>
                </ul>
            </div>
        </div>

        <!-- Lịch sử giao dịch -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Lịch sử giao dịch điểm</h5>
            </div>
            <div class="card-body">
                @if (Model.Transactions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Ngày</th>
                                    <th>Mô tả</th>
                                    <th class="text-end">Điểm</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trans in Model.Transactions)
                                {
                                    <tr>
                                        <td>@trans.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (trans.Type == "Earn")
                                            {
                                                <span class="badge bg-success me-2">Tích điểm</span>
                                            }
                                            else if (trans.Type == "Redeem")
                                            {
                                                <span class="badge bg-warning me-2">Sử dụng</span>
                                            }
                                            @trans.Description
                                        </td>
                                        <td class="text-end">
                                            <strong class="@(trans.Points > 0 ? "text-success" : "text-danger")">
                                                @(trans.Points > 0 ? "+" : "")@trans.Points
                                            </strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">
                        <i class="bi bi-inbox"></i><br />
                        Chưa có giao dịch nào
                    </p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> Không thể tải thông tin điểm thưởng.
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-5px);
    }
</style>
