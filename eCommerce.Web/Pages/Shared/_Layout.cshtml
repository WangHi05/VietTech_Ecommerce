@using Microsoft.AspNetCore.Identity
@using eCommerce.Core.Entities 
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using System.Linq
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject eCommerce.Web.Services.ICartService CartService

@{
    ApplicationUser? currentUser = null;
    string? profilePictureUrl = null;
    if (SignInManager.IsSignedIn(User))
    {
        // Lấy thông tin người dùng hiện tại để lấy URL ảnh đại diện
        currentUser = await UserManager.GetUserAsync(User);
        profilePictureUrl = currentUser?.ProfilePictureUrl; // Lấy URL ảnh (có thể null)
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VietTech - Cửa hàng điện tử</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@(Url.Content("~/css/site.css"))" asp-append-version="true" />
    <link rel="stylesheet" href="@(Url.Content("~/css/cart.css"))" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="container-custom">
            <div class="nav-left">
                <a class="logo" href="/">VietTech</a>
                <ul class="main-menu">
                    <li><a href="/">Trang Chủ</a></li>
                    <li><a href="/Products">Sản Phẩm</a></li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li><a href="/Orders">Đơn hàng của tôi</a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-area="Admin" asp-page="/Index">Quản Lý Admin</a></li>
                    }
                </ul>
            </div>

            <div class="nav-center">
                <form class="search-form" action="/Search" method="get">
                    <input type="text" 
                    name="query" 
                    class="search-input" 
                    id="searchInput"  placeholder="Nhập tên điện thoại, laptop, phụ kiện... cần tìm">
                    <button type="submit" class="search-button">
                        <svg xmlns="[http://www.w3.org/2000/svg](http://www.w3.org/2000/svg)" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </button>
                    <div id="search-suggestions" class="search-suggestions-list"></div>
                </form>
            </div>

            <div class="nav-right">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="header-action user-avatar-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Quản lý tài khoản">
                        @if (!string.IsNullOrEmpty(profilePictureUrl))
                        {
                            <img src="@profilePictureUrl" alt="Avatar" class="header-avatar-img" />
                        }
                        else
                        {
                            @* Icon mặc định nếu không có ảnh *@
                            <span class="user-icon"> @* Giữ lại class cũ để kế thừa style cơ bản *@
                                <svg xmlns="[http://www.w3.org/2000/svg](http://www.w3.org/2000/svg)" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </span>
                        }
                    </a>
                    <button id="btnEnablePush" class="btn btn-outline-primary ms-2" title="Nhận thông báo đơn hàng">Bật thông báo</button>
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" class="header-action logout-button">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a class="header-action user-icon" asp-area="Identity" asp-page="/Account/Login" title="Đăng nhập">
                        <svg xmlns="[http://www.w3.org/2000/svg](http://www.w3.org/2000/svg)" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </a>
                    <a class="header-action" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
                }

                @{ var _cartCount = 0; var _cartItems = await CartService.GetCartAsync(); if (_cartItems != null) { _cartCount = _cartItems.Sum(i => i.Quantity); } }
                <a href="/Cart" class="header-action cart-button position-relative" data-test="header-cart">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <span class="ms-1">Giỏ hàng</span>

                    <!-- ✅ Phần này thêm class để cart.js cập nhật -->
                    <span class="cart-item-count badge bg-danger position-absolute top-0 start-100 translate-middle"
                        data-test="header-cart-count"
                        style="font-size: 0.7rem;">
                        @_cartCount
                    </span>
                </a>

            </div>

        </nav>
    </header>

    <main role="main" class="container-custom">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-custom">
            <div class="footer-grid">
                <div class="footer-column">
                    <h4>Về VietTech</h4>
                    <p>VietTech là cửa hàng chuyên cung cấp các thiết bị điện tử, máy tính, phụ kiện chính hãng với giá tốt nhất và dịch vụ hậu mãi uy tín.</p>
                </div>
                <div class="footer-column">
                    <h4>Liên kết nhanh</h4>
                    <ul>
                        <li><a href="#">Về chúng tôi</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Điều khoản dịch vụ</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="footer-column">
                    <h4>Thông tin liên hệ</h4>
                    <p>
                        <strong>Địa chỉ:</strong> 123 Đường A, Quận 1, TP.HCM<br>
                        <strong>Email:</strong> support@viettech.vn<br>
                        <strong>Điện thoại:</strong> 0987 654 321
                    </p>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; 2025 - VietTech - All rights reserved.
            </div>
        </div>
    </footer>

    <script>
        // Expose VAPID public key to client JS for push subscription
        window.VAPID_PUBLIC_KEY = '@(Configuration["Vapid:PublicKey"] ?? "")';
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const slides = document.querySelector(".slides");
            if (slides) {
                const slideCount = slides.children.length;
                let currentIndex = 0;
                setInterval(() => {
                    currentIndex = (currentIndex + 1) % slideCount;
                    const offset = currentIndex * -100;
                    slides.style.transform = `translateX(${offset / slideCount}%)`;
                }, 3000);
            }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const suggestionsList = document.getElementById('search-suggestions');
            let debounceTimer;

            searchInput.addEventListener('input', function () {
                const searchTerm = this.value.trim();

                // Xóa timer cũ nếu có
                clearTimeout(debounceTimer);

                if (searchTerm.length >= 2) {
                    // Đặt timer mới, chỉ gọi API sau 300ms không gõ phím
                    debounceTimer = setTimeout(() => {
                        fetch(`/api/Products/Suggestions?term=${encodeURIComponent(searchTerm)}`)
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error('Network response was not ok');
                                }
                                return response.json();
                            })
                            .then(suggestions => {
                                displaySuggestions(suggestions);
                            })
                            .catch(error => {
                                console.error('Error fetching suggestions:', error);
                                suggestionsList.innerHTML = ''; // Xóa gợi ý cũ nếu lỗi
                                suggestionsList.style.display = 'none';
                            });
                    }, 300);
                } else {
                    suggestionsList.innerHTML = ''; // Xóa gợi ý nếu input ngắn
                    suggestionsList.style.display = 'none';
                }
            });

            // Hàm hiển thị gợi ý
            function displaySuggestions(suggestions) {
                if (suggestions && suggestions.length > 0) {
                    suggestionsList.innerHTML = ''; // Xóa gợi ý cũ
                    suggestions.forEach(suggestion => {
                        const li = document.createElement('li');
                        // Tạo link để khi bấm vào sẽ submit form tìm kiếm
                        const link = document.createElement('a');
                        link.href = `/Search?query=${encodeURIComponent(suggestion)}`;
                        link.textContent = suggestion;
                        link.addEventListener('click', function(e) {
                             // Có thể submit form thay vì chuyển link trực tiếp
                             // e.preventDefault();
                             // searchInput.value = suggestion;
                             // searchInput.closest('form').submit();
                        });
                        li.appendChild(link);
                        suggestionsList.appendChild(li);
                    });
                    suggestionsList.style.display = 'block';
                } else {
                    suggestionsList.innerHTML = '';
                    suggestionsList.style.display = 'none';
                }
            }

            // Ẩn gợi ý khi bấm ra ngoài
            document.addEventListener('click', function (event) {
                if (!searchInput.contains(event.target) && !suggestionsList.contains(event.target)) {
                    suggestionsList.style.display = 'none';
                }
            });

             // Ẩn gợi ý khi focus mất khỏi input
             searchInput.addEventListener('blur', function() {
                 // Dùng setTimeout để link gợi ý vẫn bấm được
                 setTimeout(() => {
                     suggestionsList.style.display = 'none';
                 }, 150);
             });
              // Hiển thị lại khi focus vào input (nếu có nội dung)
             searchInput.addEventListener('focus', function() {
                 if (this.value.trim().length >= 2 && suggestionsList.children.length > 0) {
                     suggestionsList.style.display = 'block';
                 }
             });

        });
    </script>

    
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@(Url.Content("~/js/cart.js"))" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/product-interactions.js" asp-append-version="true"></script>
    <script src="~/js/push-subscribe.js" asp-append-version="true"></script>
</body>
</html>

