@using Microsoft.AspNetCore.Identity
@using eCommerce.Core.Entities 
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using System.Linq
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject eCommerce.Web.Services.ICartService CartService
@inject eCommerce.Application.Services.ILoyaltyService LoyaltyService

@{
    ApplicationUser? currentUser = null;
    string? profilePictureUrl = null;
    int userPoints = 0;
    if (SignInManager.IsSignedIn(User))
    {
        // Lấy thông tin người dùng hiện tại để lấy URL ảnh đại diện
        currentUser = await UserManager.GetUserAsync(User);
        profilePictureUrl = currentUser?.ProfilePictureUrl; // Lấy URL ảnh (có thể null)
        
        // Lấy điểm thưởng của người dùng
        if (currentUser != null)
        {
            var loyaltyInfo = await LoyaltyService.GetOrCreateLoyaltyPointAsync(currentUser.Id);
            if (loyaltyInfo != null)
            {
                userPoints = loyaltyInfo.TotalPoints;
            }
        }
    }
}

