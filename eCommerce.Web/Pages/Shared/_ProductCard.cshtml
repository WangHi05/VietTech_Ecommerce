@using eCommerce.Core.Entities
@model Product

@{
    // Kiểm tra xem có yêu cầu làm nổi bật card không (từ ViewData)
    bool isHighlight = ViewData["IsHighlight"] as bool? ?? false;
    
    // Thiết lập class CSS động
    string cardClass = isHighlight ? "product-card highlight-card" : "product-card";
    string btnClass = isHighlight ? "btn-primary" : "btn-secondary";
}

<div class="@cardClass">
    <div class="product-image">
        <img src="@Model.ImageUrl" alt="@Model.Name" onerror="this.onerror=null;this.src='https://placehold.co/400x300/E2E8F0/4A5568?text=Image+Not+Found';">
    </div>
    <div class="product-info">
        <h3>@Model.Name</h3>
        <p class="product-price">@Model.Price.ToString("N0") ₫</p>
        
        @if (Model.StockQuantity > 0)
        {
            <div class="product-stock @(Model.StockQuantity <= Model.MinStockLevel ? "low-stock" : "in-stock")">
                @if (Model.StockQuantity <= Model.MinStockLevel)
                {
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>Sắp hết hàng (còn @Model.StockQuantity)</span>
                }
                else
                {
                    <i class="bi bi-check-circle"></i>
                    <span>Còn @Model.StockQuantity sản phẩm</span>
                }
            </div>
        }
        else
        {
            <div class="product-stock out-of-stock">
                <i class="bi bi-x-circle"></i>
                <span>Hết hàng</span>
            </div>
        }
        
        <form method="post" asp-page="/Cart" asp-route-handler="Add" class="inline-form">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="qty" value="1" />
            
            @* Nút bấm thay đổi class tùy vào trạng thái Highlight *@
            <button type="submit" class="@btnClass" @(Model.StockQuantity <= 0 ? "disabled" : "")>
                <i class="bi bi-cart-plus" style="margin-right: 12px;" aria-hidden="true"></i>
                @(isHighlight ? "Thêm vào giỏ" : "Xem ngay")
            </button>
        </form>
    </div>
</div>