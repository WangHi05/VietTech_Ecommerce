@page
@model eCommerce.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="slider-container">
    <div class="slides">
        <div class="slide">
            <img src="/images/banners/banner1.png" alt="Banner quảng cáo 1">
        </div>
        <div class="slide">
            <img src="/images/banners/banner2.png" alt="Banner quảng cáo 2">
        </div>
        <div class="slide">
            <img src="/images/banners/banner3.jpg" alt="Banner quảng cáo 3">
        </div>
    </div>
</div>


<h2>Sản Phẩm Nổi Bật</h2>

<div class="product-grid">
    @if (Model.Products != null && Model.Products.Any())
    {
        @foreach (var product in Model.Products)
        {
            <div class="product-card">
              
                <div class="product-image">
                   
                    <a asp-page="/ProductDetails/Detail" asp-route-id="@product.Id">
                        <img src="@product.ImageUrl" alt="@product.Name" onerror="this.onerror=null;this.src='https://placehold.co/400x300/E2E8F0/4A5568?text=Image+Not+Found';">
                    </a>
                </div>
                
               
                <div class="product-info">
                   
                    <div class="product-category">@product.Brand?.Name</div>
                    
                   
                    <h3>
                        <a asp-page="/ProductDetails/Detail" asp-route-id="@product.Id">
                            @product.Name
                        </a>
                    </h3>
                    
            
                    <div class="product-rating">
                        <div class="product-stars">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        </div>
                        <span class="product-rating-count">(128)</span>
                    </div>
                    
            
                    <div class="product-price-section">
                        <p class="product-price">@product.Price.ToString("N0") ₫</p>
                    
                        <span class="product-old-price">25.990.000 ₫</span>
                        <span class="product-discount">-20%</span>
                    </div>
                    

                    <ul class="product-features">
                        <li>Bảo hành 12 tháng</li>
                        <li>Miễn phí vận chuyển</li>
                        <li>Trả góp 0%</li>
                    </ul>
                    
                
                    <div class="product-stock in-stock">
                        Còn hàng
                    </div>
                
                    

                    <a href="#" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        Thêm vào giỏ
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <p>Chưa có sản phẩm nào để hiển thị.</p>
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.inline-form').forEach(function (form) {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                try {
                    const url = form.getAttribute('action') || '/Cart?handler=Add';
                    const formData = new FormData(form);
                    const resp = await fetch(url, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData,
                        credentials: 'same-origin'
                    });
                    if (resp.ok) {
                        // try parse JSON; server returns JSON for AJAX
                        const json = await resp.json().catch(() => null);
                        if (json && json.count !== undefined) {
                            const el = document.querySelector('.cart-item-count[data-test="header-cart-count"]') || document.querySelector('.cart-item-count');
                            if (el) el.textContent = json.count;
                        }
                    }
                } catch (err) {
                    console.error('Add to cart failed', err);
                }
            });
        });
    });
</script>