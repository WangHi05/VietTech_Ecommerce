@page
@model eCommerce.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Slider with Overlay Content -->
<div class="slider-container">
    <div class="hero-content">
         <span class="hero-badge">Sản phẩm điện tử chính hãng</span>
        <h1 class="hero-title">Nâng cấp trải nghiệm của bạn với sản phẩm độc đáo</h1>
        <p class="hero-subtitle">Giảm giá đến 30% cho sản phẩm chính hãng</p>
        <a href="/Products" class="hero-cta">
            Mua ngay
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </a>
    </div>
    <div class="slides">
        <div class="slide">
            <img src="/images/banners/banner4.jpg" alt="Banner quảng cáo">
        </div>
       
    </div>
</div>

<!-- Category Section -->
<section class="category-section">
    <div class="section-header">
        <h3 class="section-title">Danh mục sản phẩm</h2>
    </div>
    <div class="category-grid">
        <a href="/Products?categoryId=1" class="category-card">
            <span class="category-badge hot">Hot</span>
            <div class="category-icon">
                <img src="/images/products/lap1.jpg" alt="Laptop" onerror="this.src='https://placehold.co/200x200/E2E8F0/4A5568?text=Phone'">
            </div>
            <span class="category-name">Laptop</span>
        </a>
        
        <a href="/Products?categoryId=2" class="category-card">
            <span class="category-badge new">New</span>
            <div class="category-icon">
                <img src="/images/products/chuot1.jpg" alt="Chuột" onerror="this.src='https://placehold.co/200x200/E2E8F0/4A5568?text=Laptop'">
            </div>
            <span class="category-name">Chuột</span>
        </a>
        
        <a href="/Products?categoryId=3" class="category-card">
            <div class="category-icon">
                <img src="/images/products/banphim1.jpg" alt="Bàn phím" onerror="this.src='https://placehold.co/200x200/E2E8F0/4A5568?text=Tablet'">
            </div>
            <span class="category-name">Bàn phím</span>
        </a>
        
        <a href="/Products?categoryId=4" class="category-card">
            <span class="category-badge sale">Sale</span>
            <div class="category-icon">
                <img src="/images/products/tainghe1.jpg" alt="Tai nghe" onerror="this.src='https://placehold.co/200x200/E2E8F0/4A5568?text=Accessory'">
            </div>
            <span class="category-name">Tai nghe</span>
        </a>
    </div>
</section>

<!-- Flash Sale Section -->
<section class="flash-sale-section">
    <div class="flash-sale-container">
        <div class="flash-sale-content">
            <div class="flash-sale-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
                FLASH SALE
            </div>
            <h2 class="flash-sale-title">Giảm giá lên đến 50%</h2>
            <p class="flash-sale-timer">Hôm nay chỉ - Kết thúc lúc: 23:59</p>
            <a href="/Products?sortBy=price-asc" class="flash-sale-cta">
                Xem ngay
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    </div>
</section>

<!-- Products Section - Divided by Categories -->
<section class="products-section">
    @if (Model.Products != null && Model.Products.Any())
    {
        @* Nhóm sản phẩm theo Category *@
        var productsByCategory = Model.Products.GroupBy(p => p.CategoryId).Take(3);
        
        @foreach (var categoryGroup in productsByCategory)
        {
            var firstProduct = categoryGroup.First();
            var categoryName = firstProduct.Category?.Name ?? "Sản phẩm khác";
            
            <div class="category-products-section">
                <div class="category-products-header">
                    <h2 class="category-products-title">@categoryName</h2>
                    <a href="/Products?categoryId=@categoryGroup.Key" class="category-products-link">
                        Xem thêm
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>

                <div class="product-grid">
                    @foreach (var product in categoryGroup.Take(5))
                    {
                        <div class="product-card">
                            <div class="product-image">
                                <a asp-page="/ProductDetails/Detail" asp-route-id="@product.Id">
                                    <img class="product-thumb" src="@product.ImageUrl" alt="@product.Name" onerror="this.onerror=null;this.src='https://placehold.co/400x300/E2E8F0/4A5568?text=Image+Not+Found';">
                                </a>
                            </div>
                            
                            <div class="product-info">
                                <div class="product-category">@product.Brand?.Name</div>
                                
                                <h3>
                                    <a asp-page="/ProductDetails/Detail" asp-route-id="@product.Id">
                                        @product.Name
                                    </a>
                                </h3>
                                
                                <div class="product-rating">
                                    <div class="product-stars">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                    </div>
                                    <span class="product-rating-count">(128)</span>
                                </div>
                                
                                <div class="product-price-section">
                                    <p class="product-price">@product.Price.ToString("N0") ₫</p>
                                    <span class="product-old-price">@((product.Price * 1.25m).ToString("N0")) ₫</span>
                                    <span class="product-discount">-20%</span>
                                </div>

                                <ul class="product-features">
                                    <li>Bảo hành 12 tháng</li>
                                    <li>Miễn phí vận chuyển</li>
                                    <li>Trả góp 0%</li>
                                </ul>
                                
                                <div class="product-stock in-stock">
                                    Còn hàng
                                </div>
                                
                                <form method="post" asp-page="/Cart" asp-route-handler="Add" class="inline-form" data-product-id="@product.Id">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="qty" value="1" />
                                    <button type="submit" class="btn btn-primary">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="9" cy="21" r="1"></circle>
                                            <circle cx="20" cy="21" r="1"></circle>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                        </svg>
                                        Thêm vào giỏ
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div style="text-align: center; padding: 60px 20px;">
            <p style="font-size: 1.2rem; color: #64748b;">Chưa có sản phẩm nào để hiển thị.</p>
        </div>
    }
</section>
