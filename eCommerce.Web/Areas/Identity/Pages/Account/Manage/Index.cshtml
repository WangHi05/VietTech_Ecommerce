@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ"; // Chỉ giữ lại tiêu đề chính của trang con
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<partial name="_StatusMessage" model="Model.StatusMessage" />

<form id="profile-form" method="post" enctype="multipart/form-data">
    <div class="row">
        <div class="col-lg-8">
            <div class="card manage-card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">Thông tin cơ bản</h4>
                </div>
                <div class="card-body">
                
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" placeholder="Tên đăng nhập (Email)" disabled />
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Input.FullName" class="form-label"></label>
                            <input asp-for="Input.FullName" class="form-control" placeholder="Nhập họ và tên của bạn" />
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Input.PhoneNumber" class="form-label"></label>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Nhập số điện thoại"/>
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Input.Vung" class="form-label"></label>
                            <select asp-for="Input.Vung" class="form-control" id="vungSelect">
                                <option value="">-- Chọn vùng / tỉnh --</option>
                                <option value="Toàn quốc">Toàn quốc</option>
                                <option value="HCM">Hồ Chí Minh (HCM)</option>
                                <option value="HaNoi">Hà Nội</option>
                                <option value="DaNang">Đà Nẵng</option>
                                <option value="HaiPhong">Hải Phòng</option>
                                <option value="CanTho">Cần Thơ</option>
                                <option value="BinhDuong">Bình Dương</option>
                                <option value="DongNai">Đồng Nai</option>
                                <option value="KhanhHoa">Khánh Hòa</option>
                                <option value="QuangNinh">Quảng Ninh</option>
                                <option value="NgheAn">Nghệ An</option>
                                <option value="ThanhHoa">Thanh Hóa</option>
                                <option value="Other">Khác (nhập tay)</option>
                            </select>
                            <input type="text" asp-for="Input.Vung" id="vungOther" class="form-control mt-2" placeholder="Nhập vùng/tỉnh (nếu chọn Khác)" style="display:none;" />
                            <span asp-validation-for="Input.Vung" class="text-danger"></span>
                        </div>

                        <button id="update-profile-button" type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-save" viewBox="0 0 16 16"><path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1z"/></svg>
                            Lưu thay đổi
                        </button>
                
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card manage-card">
                <div class="card-header">
                    <h4 class="mb-0">Ảnh đại diện</h4>
                </div>
                <div class="card-body text-center">
                    <div class="profile-picture-container mb-3">
                        <img id="profilePicturePreview" class="profile-picture"
                            src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "https://placehold.co/150x150/E2E8F0/4A5568?text=Avatar" : Model.ProfilePictureUrl)"
                            alt="Ảnh đại diện"/>
                    </div>
                    <div class="form-group">
                        <label for="profilePictureUpload" class="btn btn-primary btn-sm">Chọn ảnh mới</label>
                        <input type="file" asp-for="Input.Upload" accept=".png,.jpg,.jpeg" id="profilePictureUpload" style="display: none;"/>
                        <span asp-validation-for="Input.Upload" class="text-danger"></span>
                    </div>
                    <small class="text-muted d-block mt-2">Chọn ảnh PNG, JPG hoặc JPEG.</small>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('profilePictureUpload').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                if (file.size > 2 * 1024 * 1024) {
                    alert("Kích thước ảnh quá lớn! Vui lòng chọn ảnh nhỏ hơn 2MB.");
                    event.target.value = null;
                    return;
                }
                const allowedTypes = ['image/png', 'image/jpeg', 'image/jpg'];
                if (!allowedTypes.includes(file.type)) {
                     alert("Định dạng ảnh không hợp lệ! Vui lòng chọn ảnh PNG, JPG hoặc JPEG.");
                     event.target.value = null;
                     return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('profilePicturePreview').src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        });
        // Toggle custom region input when "Other" is selected
        (function() {
            const select = document.getElementById('vungSelect');
            const other = document.getElementById('vungOther');
            if (!select) return;

            function update() {
                if (select.value === 'Other') {
                    other.style.display = 'block';
                    other.focus();
                } else {
                    // If switching away from Other, copy select value into hidden input (so model binds)
                    if (select.value && select.value !== '') {
                        other.value = select.value;
                    }
                    other.style.display = 'none';
                }
            }

            select.addEventListener('change', update);

            // Initialize on load: if model had a saved value not in options, show Other and fill
            const current = select.getAttribute('data-val') || '';
            // If server bound value is not one of options, set select to Other and fill input
            (function initFromModel() {
                const bound = '@(Model.Input?.Vung ?? string.Empty)';
                if (!bound) return;
                const opts = Array.from(select.options).map(o => o.value);
                if (opts.includes(bound)) {
                    select.value = bound;
                } else {
                    select.value = 'Other';
                    other.style.display = 'block';
                    other.value = bound;
                }
            })();
        })();
    </script>
}