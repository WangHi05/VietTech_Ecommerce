@page
@model IndexModel
@{
    ViewData["Title"] = "Báo Cáo & Thống Kê";
}

<h2 class="page-title">@ViewData["Title"]</h2>

<div class="stat-card-row">
    <div class="stat-card">
        <div class="stat-card-info">
            <div class="stat-label text-primary">Tổng Doanh Thu</div>
            <div class="stat-value">@Model.TotalRevenue.ToString("N0") đ</div>
        </div>
        <div class="stat-card-icon text-primary">
            <i class="bi bi-calendar-check"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-info">
            <div class="stat-label text-success">Doanh Thu (Hôm Nay)</div>
            <div class="stat-value">@Model.RevenueToday.ToString("N0") đ</div>
        </div>
        <div class="stat-card-icon text-success">
            <i class="bi bi-cash-coin"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-info">
            <div class="stat-label text-info">Tổng Số Đơn Hàng</div>
            <div class="stat-value">@Model.TotalOrders</div>
        </div>
        <div class="stat-card-icon text-info">
            <i class="bi bi-clipboard-data"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-info">
            <div class="stat-label text-warning">Tổng Khách Hàng</div>
            <div class="stat-value">@Model.TotalCustomers</div>
        </div>
        <div class="stat-card-icon text-warning">
            <i class="bi bi-people-fill"></i>
        </div>
    </div>
</div>

<div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h6 class="m-0">Các Đơn Hàng Gần Đây</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Khách Hàng</th>
                            <th>Ngày Đặt</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.Customer?.FullName</td>
                                <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@order.Total.ToString("N0") đ</td>
                                <td>@order.Status</td>
                                <td>
                                    <a asp-area="Admin" asp-page="/Orders/Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">
                                        Chi Tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
</div>
<div class="row">
    <div class="col-lg-12 mb-4">
        <div class="card">
            <div class="card-header">
                <h6 class="m-0">Doanh thu 7 ngày qua</h6>
            </div>
            <div class="card-body">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueChart').getContext('2d');
        const chartLabels = @Json.Serialize(Model.ChartLabels);
        const chartData = @Json.Serialize(Model.ChartData);

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: chartData,
                    backgroundColor: 'rgba(234, 88, 12, 0.8)',
                    borderColor: 'rgba(234, 88, 12, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value, index, values) {
                                return new Intl.NumberFormat('vi-VN').format(value) + ' đ';
                            }
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                if (context.parsed.y !== null) {
                                    label += new Intl.NumberFormat('vi-VN').format(context.parsed.y) + ' đ';
                                }
                                return label;
                            }
                        }
                    }
                }
            }
        });
    </script>
}