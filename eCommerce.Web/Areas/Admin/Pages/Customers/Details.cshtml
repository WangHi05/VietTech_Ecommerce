@page
@model DetailsModel
@{
    ViewData["Title"] = "Chi Tiết Khách Hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]: @Model.Customer.FullName</h2>
    <a asp-page="./Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay Lại Danh Sách
    </a>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Thông Tin Khách Hàng</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Họ Tên</dt>
            <dd class="col-sm-9">@Model.Customer.FullName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Customer.Email</dd>

            <dt class="col-sm-3">Số Điện Thoại</dt>
            <dd class="col-sm-9">@(Model.Customer.PhoneNumber ?? "Chưa cập nhật")</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Lịch Sử Đơn Hàng (@Model.Orders.Count())</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Mã Đơn Hàng</th>
                    <th>Ngày Đặt</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái ĐH</th>
                    <th>Trạng Thái TT</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>@order.Total.ToString("N0") đ</td>
                        <td>@order.Status</td>
                        <td>@order.PaymentStatus</td>
                        <td>
                            <a asp-area="Admin" asp-page="/Orders/Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">
                                Xem Đơn
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>