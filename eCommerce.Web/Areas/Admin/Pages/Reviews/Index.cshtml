@page
@model eCommerce.Web.Areas.Admin.Pages.Reviews.IndexModel
@{
    ViewData["Title"] = "Quản lý Đánh Giá";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Danh sách Đánh Giá</h1>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger">@TempData["error"]</div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Các đánh giá mới nhất</h6>
        </div>
        <div class="card-body">
            <form method="get" class="row g-2 mb-3">
                <div class="col-auto">
                    <input type="number" name="filterProductId" class="form-control form-control-sm" placeholder="Product ID" value="@Model.FilterProductId" />
                </div>
                <div class="col-auto">
                    <select name="filterStatus" class="form-select form-select-sm">
                        <option value="">-- Trạng thái --</option>
                        @{ var s = Model.FilterStatus ?? ""; }
                        @if (s == "Pending") { <option value="Pending" selected>Pending</option> } else { <option value="Pending">Pending</option> }
                        @if (s == "Approved") { <option value="Approved" selected>Approved</option> } else { <option value="Approved">Approved</option> }
                        @if (s == "Rejected") { <option value="Rejected" selected>Rejected</option> } else { <option value="Rejected">Rejected</option> }
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-primary" type="submit">Lọc</button>
                    <a class="btn btn-sm btn-outline-secondary" href="?">Reset</a>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px">#</th>
                            <th>Sản phẩm</th>
                            <th>Người dùng</th>
                            <th>Rating</th>
                            <th>Bình luận</th>
                            <th>Ngày</th>
                            <th>Trạng thái</th>
                            <th style="width:180px">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Reviews)
                        {
                            var statusClass = r.Status == "Approved" ? "text-success" : (r.Status == "Rejected" ? "text-danger" : "text-muted");
                            <tr>
                                <td>@r.ReviewId</td>
                                <td>
                                    <div class="fw-bold">
                                        <a asp-page="/ProductDetails/Detail" asp-route-id="@r.ProductId">@r.ProductName</a>
                                    </div>
                                    <div class="text-muted">ID: @r.ProductId</div>
                                </td>
                                <td>
                                    <div>@(string.IsNullOrEmpty(r.UserName) ? "Khách" : r.UserName)</div>
                                    @if (!string.IsNullOrEmpty(r.UserId)) { <div class="text-muted small">@r.UserId</div> }
                                </td>
                                <td>@for (int s = 0; s < r.Rating; s++) { <span>⭐</span> }</td>
                                <td>@r.Comment</td>
                                <td>@r.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="@statusClass fw-bold">@r.Status</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        @if (r.Status != "Approved")
                                        {
                                            <form method="post" asp-page-handler="Approve" asp-route-id="@r.ReviewId" asp-route-pageNumber="@Model.PageNumber" asp-route-filterProductId="@Model.FilterProductId" asp-route-filterStatus="@Model.FilterStatus">
                                                <button type="submit" class="btn btn-sm btn-success" title="Approve"> <i class="bi bi-check-lg"></i> Duyệt</button>
                                            </form>
                                        }
                                        @if (r.Status != "Rejected")
                                        {
                                            <form method="post" asp-page-handler="Reject" asp-route-id="@r.ReviewId" asp-route-pageNumber="@Model.PageNumber" asp-route-filterProductId="@Model.FilterProductId" asp-route-filterStatus="@Model.FilterStatus">
                                                <button type="submit" class="btn btn-sm btn-warning" title="Reject"> <i class="bi bi-x-lg"></i> Từ chối</button>
                                            </form>
                                        }
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@r.ReviewId" asp-route-pageNumber="@Model.PageNumber" asp-route-filterProductId="@Model.FilterProductId" asp-route-filterStatus="@Model.FilterStatus" onsubmit="return confirm('Xác nhận xóa đánh giá này?');">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete"> <i class="bi bi-trash"></i> Xóa</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav aria-label="Page navigation" class="mt-3">
                <ul class="pagination">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" href="?pageNumber=@(Model.PageNumber - 1)&filterProductId=@Model.FilterProductId&filterStatus=@Model.FilterStatus">Previous</a>
                    </li>
                    @for (int p = 1; p <= (Model.TotalPages == 0 ? 1 : Model.TotalPages); p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")"><a class="page-link" href="?pageNumber=@p&filterProductId=@Model.FilterProductId&filterStatus=@Model.FilterStatus">@p</a></li>
                    }
                    <li class="page-item @(Model.PageNumber >= (Model.TotalPages == 0 ? 1 : Model.TotalPages) ? "disabled" : "")">
                        <a class="page-link" href="?pageNumber=@(Model.PageNumber + 1)&filterProductId=@Model.FilterProductId&filterStatus=@Model.FilterStatus">Next</a>
                    </li>
                </ul>
            </nav>
            @if (!Model.Reviews.Any())
            {
                <div class="text-center py-4 text-muted">Chưa có đánh giá nào.</div>
            }
        </div>
    </div>
</div>
