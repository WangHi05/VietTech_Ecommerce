@page
@model eCommerce.Web.Areas.Admin.Pages.Notifications.SendModel
@{
    ViewData["Title"] = "Gửi thông báo hàng loạt";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Gửi thông báo khuyến mãi</h6>
    </div>
    <div class="card-body">
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success">@TempData["success"]</div>
        }
        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger">@TempData["error"]</div>
        }

        <form method="post">
            <div class="form-group mb-3">
                <label asp-for="Input.Title" class="form-label fw-bold"></label>
                <input asp-for="Input.Title" class="form-control" placeholder="VD: Giảm giá sốc cuối tuần!" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Body" class="form-label fw-bold"></label>
                <textarea asp-for="Input.Body" class="form-control" rows="3" placeholder="VD: Nhập mã SALE50 để được giảm 50%..."></textarea>
                <span asp-validation-for="Input.Body" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Url" class="form-label fw-bold"></label>
                <input asp-for="Input.Url" class="form-control" placeholder="VD: /Products hoặc /Cart" />
                <small class="text-muted">Đường dẫn khách hàng sẽ được chuyển đến khi bấm vào thông báo.</small>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-send-fill"></i> Gửi thông báo ngay
            </button>
        </form>
    </div>
</div>