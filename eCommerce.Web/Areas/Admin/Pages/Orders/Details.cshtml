@page
@model DetailsModel
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.Order.Id;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-page="./Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay Lại Danh Sách
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Thông Tin Khách Hàng</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Tên Khách Hàng</dt>
                    <dd class="col-sm-8">@Model.Order.Customer?.FullName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Order.Customer?.Email</dd>

                    <dt class="col-sm-4">Người Nhận</dt>
                    <dd class="col-sm-8">@Model.Order.ShippingName</dd>
                    
                    <dt class="col-sm-4">Địa Chỉ Giao</dt>
                    <dd class="col-sm-8">@Model.Order.ShippingAddress</dd>

                    <dt class="col-sm-4">Tỉnh/Thành</dt>
                    <dd class="col-sm-8">@Model.Order.ShippingProvince</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Thông Tin Đơn Hàng</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Ngày Đặt Hàng</dt>
                    <dd class="col-sm-8">@Model.Order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Trạng Thái ĐH</dt>
                    <dd class="col-sm-8">@Model.Order.Status</dd>
                    <dt class="col-sm-4">Quản lý</dt>
                    <dd class="col-sm-8">
                        @if (Model.Order != null && Model.Order.Status == "Đang chờ")
                        {
                            <form method="post" asp-page-handler="Confirm" style="display:inline-block;margin-right:8px;">
                                <input type="hidden" name="id" value="@Model.Order.Id" />
                                <button type="submit" class="btn btn-success btn-sm">Xác nhận</button>
                            </form>
                            <form method="post" asp-page-handler="Cancel" style="display:inline-block;">
                                <input type="hidden" name="id" value="@Model.Order.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Huỷ</button>
                            </form>
                        }
                        else if (Model.Order != null && Model.Order.Status == "Đang xử lý")
                        {
                            <form method="post" asp-page-handler="Ship" style="display:inline-block;margin-right:8px;">
                                <input type="hidden" name="id" value="@Model.Order.Id" />
                                <button type="submit" class="btn btn-primary btn-sm">Bàn giao cho đơn vị vận chuyển</button>
                            </form>
                            <form method="post" asp-page-handler="Cancel" style="display:inline-block;">
                                <input type="hidden" name="id" value="@Model.Order.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Huỷ</button>
                            </form>
                        }
                        else if (Model.Order != null && Model.Order.Status == "Đang giao hàng")
                        {
                            <form method="post" asp-page-handler="Complete" style="display:inline-block;">
                                <input type="hidden" name="id" value="@Model.Order.Id" />
                                <button type="submit" class="btn btn-primary btn-sm">Hoàn thành & Tích điểm</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">Không có hành động</span>
                        }
                    </dd>
                    
                    <dt class="col-sm-4">Thanh Toán</dt>
                    <dd class="col-sm-8">@Model.Order.PaymentMethod</dd>

                    <dt class="col-sm-4">Trạng Thái TT</dt>
                    <dd class="col-sm-8">@Model.Order.PaymentStatus</dd>

                    <dt class="col-sm-4">Tổng Tiền</dt>
                    <dd class="col-sm-8"><strong class="fs-5 text-danger">@Model.Order.Total.ToString("N0") đ</strong></dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Các Sản Phẩm Trong Đơn</h5>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>Sản Phẩm</th>
                    <th>Giá</th>
                    <th>Số Lượng</th>
                    <th>Tổng Phụ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Order.Items)
                {
                    <tr>
                        <td>
                            <strong>@item.Product?.Name</strong>
                            <p class="text-muted small">@item.Name</p> </td>
                        <td>@item.Price.ToString("N0") đ</td>
                        <td>@item.Quantity</td>
                        <td>@item.LineTotal.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>