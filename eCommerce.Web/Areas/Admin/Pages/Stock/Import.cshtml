@page
@model eCommerce.Web.Areas.Admin.Pages.Stock.ImportModel
@{
    ViewData["Title"] = "Nhập hàng vào kho";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0"><i class="bi bi-box-arrow-in-down"></i> Nhập hàng vào kho</h3>
                    <a asp-page="/Stock/History" class="btn btn-secondary">
                        <i class="bi bi-clock-history"></i> Xem lịch sử
                    </a>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" class="needs-validation" novalidate>
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="ProductId" class="form-label">Sản phẩm <span class="text-danger">*</span></label>
                                    <select asp-for="ProductId" class="form-select" required>
                                        <option value="">-- Chọn sản phẩm --</option>
                                        @foreach (var product in Model.Products)
                                        {
                                            <option value="@product.Id">
                                                @product.Name (Tồn: @product.StockQuantity)
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="ProductId" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label">Số lượng nhập <span class="text-danger">*</span></label>
                                    <input asp-for="Quantity" type="number" class="form-control" min="1" required />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Reason" class="form-label">Lý do nhập hàng <span class="text-danger">*</span></label>
                                    <textarea asp-for="Reason" class="form-control" rows="3" required 
                                              placeholder="Ví dụ: Nhập từ nhà cung cấp ABC, đơn hàng #123"></textarea>
                                    <span asp-validation-for="Reason" class="text-danger"></span>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-save"></i> Nhập hàng
                                    </button>
                                    <a asp-page="/ManageProducts" class="btn btn-secondary">
                                        <i class="bi bi-arrow-left"></i> Quay lại
                                    </a>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-info-circle"></i> Hướng dẫn</h5>
                                        <ul class="small mb-0">
                                            <li>Chọn sản phẩm cần nhập hàng</li>
                                            <li>Nhập số lượng (phải > 0)</li>
                                            <li>Ghi rõ lý do để dễ theo dõi</li>
                                            <li>Hệ thống sẽ tự động cập nhật tồn kho</li>
                                            <li>Lịch sử thay đổi được lưu lại</li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="card bg-warning bg-opacity-10 mt-3">
                                    <div class="card-body">
                                        <h6><i class="bi bi-exclamation-triangle text-warning"></i> Sản phẩm sắp hết hàng</h6>
                                        <div class="small">
                                            @if (Model.LowStockProducts.Any())
                                            {
                                                <ul class="mb-0">
                                                    @foreach (var product in Model.LowStockProducts.Take(5))
                                                    {
                                                        <li>@product.Name: <strong class="text-danger">@product.StockQuantity</strong></li>
                                                    }
                                                </ul>
                                                @if (Model.LowStockProducts.Count > 5)
                                                {
                                                    <a asp-page="/Stock/LowStock" class="text-decoration-none">
                                                        Xem thêm @(Model.LowStockProducts.Count - 5) sản phẩm...
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-success mb-0">Tất cả sản phẩm đều còn đủ hàng!</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
