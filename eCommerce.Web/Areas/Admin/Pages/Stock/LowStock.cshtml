@page
@model eCommerce.Web.Areas.Admin.Pages.Stock.LowStockModel
@{
    ViewData["Title"] = "Sản phẩm sắp hết hàng";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                        <i class="bi bi-exclamation-triangle text-warning"></i> 
                        Sản phẩm sắp hết hàng
                    </h3>
                    <div>
                        <a asp-page="/Stock/Import" class="btn btn-success me-2">
                            <i class="bi bi-box-arrow-in-down"></i> Nhập hàng
                        </a>
                        <a asp-page="/Stock/History" class="btn btn-secondary">
                            <i class="bi bi-clock-history"></i> Lịch sử
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.LowStockProducts.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> 
                            <strong>Cảnh báo:</strong> Có <strong>@Model.LowStockProducts.Count</strong> sản phẩm 
                            có tồn kho thấp hơn hoặc bằng mức cảnh báo. Vui lòng nhập hàng kịp thời!
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Hình ảnh</th>
                                        <th>Sản phẩm</th>
                                        <th>Danh mục</th>
                                        <th>Thương hiệu</th>
                                        <th>Tồn kho</th>
                                        <th>Mức cảnh báo</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.LowStockProducts)
                                    {
                                        var stockPercentage = product.MinStockLevel > 0 
                                            ? (product.StockQuantity * 100.0 / product.MinStockLevel) 
                                            : 100;
                                        var alertClass = product.StockQuantity == 0 ? "table-danger" 
                                            : stockPercentage <= 50 ? "table-danger" 
                                            : "table-warning";
                                        
                                        <tr class="@alertClass">
                                            <td>
                                                <img src="@product.ImageUrl" alt="@product.Name" 
                                                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;"
                                                     onerror="this.src='https://placehold.co/50x50/E2E8F0/4A5568?text=No+Img'">
                                            </td>
                                            <td>
                                                <a asp-page="/ProductDetails/Detail" asp-route-id="@product.Id" 
                                                   class="text-decoration-none fw-bold">
                                                    @product.Name
                                                </a>
                                            </td>
                                            <td>@product.Category?.Name</td>
                                            <td>@product.Brand?.Name</td>
                                            <td>
                                                <span class="badge @(product.StockQuantity == 0 ? "bg-danger" : "bg-warning")">
                                                    <strong style="font-size: 1.1rem;">@product.StockQuantity</strong>
                                                </span>
                                            </td>
                                            <td>
                                                <small class="text-muted">≤ @product.MinStockLevel</small>
                                            </td>
                                            <td>
                                                @if (product.StockQuantity == 0)
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-x-circle"></i> Hết hàng
                                                    </span>
                                                }
                                                else if (stockPercentage <= 50)
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-exclamation-triangle"></i> Rất thấp
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">
                                                        <i class="bi bi-exclamation-circle"></i> Thấp
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-page="/Stock/Import" asp-route-preselectedProductId="@product.Id" 
                                                   class="btn btn-sm btn-success" title="Nhập hàng">
                                                    <i class="bi bi-box-arrow-in-down"></i> Nhập
                                                </a>
                                                <a asp-page="/Stock/History" asp-route-productId="@product.Id" 
                                                   class="btn btn-sm btn-secondary" title="Xem lịch sử">
                                                    <i class="bi bi-clock-history"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Thống kê -->
                        <div class="row mt-4">
                            <div class="col-md-4">
                                <div class="card bg-danger bg-opacity-10">
                                    <div class="card-body text-center">
                                        <h2 class="text-danger mb-0">
                                            @Model.LowStockProducts.Count(p => p.StockQuantity == 0)
                                        </h2>
                                        <small class="text-muted">Sản phẩm hết hàng</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-warning bg-opacity-10">
                                    <div class="card-body text-center">
                                        <h2 class="text-warning mb-0">
                                            @Model.LowStockProducts.Count(p => p.StockQuantity > 0 && p.StockQuantity <= p.MinStockLevel / 2)
                                        </h2>
                                        <small class="text-muted">Sản phẩm rất thấp</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-info bg-opacity-10">
                                    <div class="card-body text-center">
                                        <h2 class="text-info mb-0">
                                            @Model.LowStockProducts.Count(p => p.StockQuantity > p.MinStockLevel / 2 && p.StockQuantity <= p.MinStockLevel)
                                        </h2>
                                        <small class="text-muted">Sản phẩm cần bổ sung</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> 
                            <strong>Tuyệt vời!</strong> Tất cả sản phẩm đều có tồn kho trên mức cảnh báo.
                        </div>

                        <div class="text-center py-5">
                            <i class="bi bi-emoji-smile" style="font-size: 5rem; color: var(--success-color);"></i>
                            <h4 class="mt-3">Không có sản phẩm nào cần cảnh báo</h4>
                            <p class="text-muted">Hệ thống tồn kho đang hoạt động tốt!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
