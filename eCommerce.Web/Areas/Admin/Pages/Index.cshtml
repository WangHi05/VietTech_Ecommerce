@page
@model IndexModel
@{
    ViewData["Title"] = "Quản Lý VietTech";
}

<h2 class="page-title">@ViewData["Title"]</h2>

<div class="mb-4">
    <a asp-page="./AddProduct" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill"></i> Thêm Sản Phẩm Mới
    </a>
</div>

@if (TempData["success"] != null)
{
    <div class="alert alert-success">@TempData["success"]</div>
}

<div class="card">
    <div class="card-body p-0"> <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Danh Mục</th>
                    <th>Thương Hiệu</th>
                    <th>Giá</th>
                    <th>Tồn Kho</th>
                    <th style="width: 120px;">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>
                            <img src="@product.ImageUrl" alt="@product.Name" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" />
                        </td>
                        <td>@product.Name</td>
                        <td>@product.Category?.Name</td>
                        <td>@product.Brand?.Name</td>
                        <td>@product.Price.ToString("N0") đ</td>
                        <td>@product.StockQuantity</td>
                        <td>
                            <a asp-page="./EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-info"><i class="bi bi-pencil-fill"></i></a>
                            <a asp-page="./DeleteProduct" asp-route-id="@product.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash-fill"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>