<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trang Quản Trị</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>

    <nav class="sidebar">
        <div>
            <div class="sidebar-header">
                <a asp-area="Admin" asp-page="/Index" class="sidebar-logo">
                    Admin Viettech
                </a>
            </div>
            
            <ul class="sidebar-nav">
                <li>
                    <a asp-area="Admin" asp-page="/Index" class="nav-link">
                        <i class="bi bi-box-seam-fill"></i> Quản Lý Sản Phẩm
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-page="/Orders/Index" class="nav-link">
                        <i class="bi bi-receipt"></i> Quản Lý Đơn Hàng
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-page="/Customers/Index" class="nav-link">
                        <i class="bi bi-people-fill"></i> Quản Lý Khách Hàng
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-box"></i> Quản Lý Tồn Kho
                    </a>
                    <ul class="dropdown-menu">
                        <li>
                            <a asp-area="Admin" asp-page="/Stock/LowStock" class="dropdown-item">
                                <i class="bi bi-exclamation-triangle text-warning"></i> Cảnh Báo Tồn Kho
                            </a>
                        </li>
                        <li>
                            <a asp-area="Admin" asp-page="/Stock/Import" class="dropdown-item">
                                <i class="bi bi-box-arrow-in-down text-success"></i> Nhập Hàng
                            </a>
                        </li>
                        <li>
                            <a asp-area="Admin" asp-page="/Stock/Adjust" class="dropdown-item">
                                <i class="bi bi-gear text-warning"></i> Điều Chỉnh
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a asp-area="Admin" asp-page="/Stock/History" class="dropdown-item">
                                <i class="bi bi-clock-history text-secondary"></i> Lịch Sử
                            </a>
                        </li>
                    </ul>
                </li>
                 <li>
                    <a href="#" class="nav-link">
                        <i class="bi bi-star me"></i>Quản Lý Đánh Giá
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link collapsed custom-nav-link" href="#" data-bs-toggle="collapse" data-bs-target="#collapseMarketing" aria-expanded="false" aria-controls="collapseMarketing">
                        <i class="bi bi-megaphone-fill"></i>
                        <span>Marketing & Push</span>
                        <i class="bi bi-chevron-down ms-auto rotate-icon"></i>
                    </a>

                    <div id="collapseMarketing" class="collapse" data-parent="#accordionSidebar">
                        <ul class="bg-white py-2 collapse-inner rounded list-unstyled custom-submenu">
                            
                            <li>
                                <a class="collapse-item custom-sub-link" asp-area="Admin" asp-page="/Notifications/Send">
                                    <i class="bi bi-send"></i>
                                    <span>Gửi thông báo</span>
                                </a>
                            </li>

                            <li>
                                <a class="collapse-item custom-sub-link" asp-area="Admin" asp-page="/Vouchers/Index">
                                    <i class="bi bi-ticket-perforated"></i>
                                    <span>Quản lý Voucher</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li>
                    <a asp-area="Admin" asp-page="/Reports/Index" class="nav-link">
                        <i class="bi bi-bar-chart-line-fill"></i> Báo Cáo Doanh Thu
                    </a>
                </li>
                </ul>
        </div>

        <div class="sidebar-footer">
             <a asp-area="" asp-page="/Index" class="nav-link">
                <i class="bi bi-arrow-left-circle-fill"></i> Quay về trang chủ
            </a>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll(".sidebar-nav .nav-link");

            navLinks.forEach(link => {
                const linkPath = link.getAttribute("href");
                
                // So sánh chính xác
                if (currentPath === linkPath) {
                    link.classList.add("active");
                }
                
                // Trường hợp đặc biệt: Nếu đang ở /Admin/Orders/Details/1
                // thì link /Admin/Orders/Index cũng nên active
                if (linkPath !== "/Admin" && currentPath.startsWith(linkPath)) {
                     // Kiểm tra link không phải là link trang chủ (sản phẩm)
                     if (linkPath !== "/Admin/Index" || currentPath === "/Admin/Index") {
                        link.classList.add("active");
                     }
                }
                
                // Xử lý riêng cho trang chủ admin (Quản lý Sản phẩm)
                // Vì /Admin/AddProduct, /Admin/EditProduct cũng thuộc nó
                if (linkPath === "/Admin/Index" && (currentPath.startsWith("/Admin/EditProduct") || currentPath.startsWith("/Admin/AddProduct") || currentPath.startsWith("/Admin/DeleteProduct"))) {
                     link.classList.add("active");
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>