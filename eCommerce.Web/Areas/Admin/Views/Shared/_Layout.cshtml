<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trang Quản Trị</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>

    <nav class="sidebar">
        <div>
            <div class="sidebar-header">
                <a asp-area="Admin" asp-page="/Index" class="sidebar-logo">
                    Admin Viettech
                </a>
            </div>
            
            <ul class="sidebar-nav">
                <li>
                    <a asp-area="Admin" asp-page="/Index" class="nav-link">
                        <i class="bi bi-box-seam-fill"></i> Quản Lý Sản Phẩm
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-page="/Orders/Index" class="nav-link">
                        <i class="bi bi-receipt"></i> Quản Lý Đơn Hàng
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-page="/Customers/Index" class="nav-link">
                        <i class="bi bi-people-fill"></i> Quản Lý Khách Hàng
                    </a>
                </li>
                 <li>
                    <a href="#" class="nav-link">
                        <i class="bi bi-star me-2"></i> Quản Lý Đánh Giá
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-page="/Reports/Index" class="nav-link">
                        <i class="bi bi-bar-chart-line-fill"></i> Báo Cáo Doanh Thu
                    </a>
                </li>
                </ul>
        </div>

        <div class="sidebar-footer">
             <a asp-area="" asp-page="/Index" class="nav-link">
                <i class="bi bi-arrow-left-circle-fill"></i> Quay về trang chủ
            </a>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll(".sidebar-nav .nav-link");

            navLinks.forEach(link => {
                const linkPath = link.getAttribute("href");
                
                // So sánh chính xác
                if (currentPath === linkPath) {
                    link.classList.add("active");
                }
                
                // Trường hợp đặc biệt: Nếu đang ở /Admin/Orders/Details/1
                // thì link /Admin/Orders/Index cũng nên active
                if (linkPath !== "/Admin" && currentPath.startsWith(linkPath)) {
                     // Kiểm tra link không phải là link trang chủ (sản phẩm)
                     if (linkPath !== "/Admin/Index" || currentPath === "/Admin/Index") {
                        link.classList.add("active");
                     }
                }
                
                // Xử lý riêng cho trang chủ admin (Quản lý Sản phẩm)
                // Vì /Admin/AddProduct, /Admin/EditProduct cũng thuộc nó
                if (linkPath === "/Admin/Index" && (currentPath.startsWith("/Admin/EditProduct") || currentPath.startsWith("/Admin/AddProduct") || currentPath.startsWith("/Admin/DeleteProduct"))) {
                     link.classList.add("active");
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>